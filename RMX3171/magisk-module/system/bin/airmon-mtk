#!/bin/sh
# airmon-mtk: CLI monitor mode wrapper for MediaTek gen4m wireless drivers
# Target Device: Realme Narzo 30A (RMX3171 / MT6768 Helio G85)
# Reverse-engineered by Shado & Antigravity (2026)

export PATH="/data/data/com.termux/files/usr/bin:/product/bin:/apex/com.android.runtime/bin:/apex/com.android.art/bin:/system_ext/bin:/system/bin:/system/xbin:/odm/bin:/vendor/bin:/vendor/xbin:$PATH"

WPA_SOCKET_DIR="/data/vendor/wifi/wpa/sockets"
IFACE="wlan0"
MON_IFACE="mon0"
HOP_PID_FILE="/data/local/tmp/airmon_mtk_hop.pid"
KEEPER_PID_FILE="/data/local/tmp/airmon_keeper.pid"
STATE_FILE="/data/local/tmp/airmon_saved_state"

check_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "[-] Error: airmon-mtk must be run as root." >&2
        exit 1
    fi
}

send_driver_cmd() {
    local cmd="$1"
    local wpa_bin
    wpa_bin=$(command -v wpa_cli 2>/dev/null || echo "/vendor/bin/wpa_cli")
    "$wpa_bin" -i "$IFACE" -p "$WPA_SOCKET_DIR" driver "$cmd" 2>/dev/null
}

suppress_android_scanning() {
    echo "[*] Engaging pure Linux isolation (disabling Android Wi-Fi & scan managers)..."

    local was_enabled=0
    if cmd wifi status 2>/dev/null | grep -q "Wifi is enabled"; then
        was_enabled=1
    fi
    local orig_scan
    orig_scan=$(settings get global wifi_scan_always_enabled 2>/dev/null)
    [ -z "$orig_scan" ] && orig_scan="0"

    cat <<EOF > "$STATE_FILE"
WIFI_WAS_ENABLED=$was_enabled
ORIG_SCAN_ALWAYS_ENABLED=$orig_scan
EOF

    # 1. Disable framework background scanning flags
    settings put global wifi_scan_always_enabled 0 2>/dev/null
    cmd wifi set-scan-always-available disabled >/dev/null 2>&1
    pkill -9 -f "cmd wifi start-scan" 2>/dev/null

    # 2. Disable Android Wi-Fi framework completely so wificond/HAL stop touching the chip
    cmd wifi set-wifi-enabled disabled >/dev/null 2>&1 || true
    sleep 0.8
    killall -9 wpa_supplicant 2>/dev/null || true

    # 3. Direct bare-metal power-on of MT6631/MT7663 baseband via wmtWifi chardev
    echo 1 > /dev/wmtWifi 2>/dev/null || true
    sleep 0.8

    # 4. Bring up wlan0 under pure Linux control
    ip link set "$IFACE" up 2>/dev/null || true
    sleep 0.3

    # 5. Spawn isolated standalone wpa_supplicant instance
    mkdir -p "$WPA_SOCKET_DIR"
    local isolated_conf="/data/local/tmp/airmon_isolated_wpa.conf"
    cat << 'CONF' > "$isolated_conf"
ctrl_interface=/data/vendor/wifi/wpa/sockets
update_config=1
CONF
    chown -R wifi:wifi "$WPA_SOCKET_DIR" "$isolated_conf" 2>/dev/null || true
    chmod 771 "$WPA_SOCKET_DIR" 2>/dev/null || true
    /vendor/bin/hw/wpa_supplicant -O"$WPA_SOCKET_DIR" -c"$isolated_conf" -Dnl80211 -i"$IFACE" -B >/dev/null 2>&1 || true
    sleep 1
}

restore_android_scanning() {
    local WIFI_WAS_ENABLED=1
    local ORIG_SCAN_ALWAYS_ENABLED=0
    if [ -f "$STATE_FILE" ]; then
        . "$STATE_FILE" 2>/dev/null
        rm -f "$STATE_FILE"
    fi

    echo "[*] Restoring official Android Wi-Fi stack & network managers..."

    # 1. Kill isolated supplicant and clean up
    killall -9 wpa_supplicant 2>/dev/null || true
    rm -f "/data/local/tmp/airmon_isolated_wpa.conf"

    # 2. Power down direct wmtWifi chardev
    echo 0 > /dev/wmtWifi 2>/dev/null || true
    sleep 1

    # 3. Restore Android framework settings
    settings put global wifi_scan_always_enabled "$ORIG_SCAN_ALWAYS_ENABLED" 2>/dev/null
    if [ "$ORIG_SCAN_ALWAYS_ENABLED" = "1" ]; then
        cmd wifi set-scan-always-available enabled >/dev/null 2>&1
    fi

    # 4. Re-enable official Android Wi-Fi framework if it was active
    if [ "$WIFI_WAS_ENABLED" -eq 1 ]; then
        echo "[*] Re-enabling Android Wi-Fi service..."
        cmd wifi set-wifi-enabled enabled >/dev/null 2>&1
    fi
}

start_keeper() {
    stop_keeper
    iw dev "$IFACE" set power_save off 2>/dev/null
    echo "airmon_wake" > /sys/power/wake_lock 2>/dev/null
}

stop_keeper() {
    if [ -f "$KEEPER_PID_FILE" ]; then
        local pid
        pid=$(cat "$KEEPER_PID_FILE" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            kill -9 "$pid" 2>/dev/null
        fi
        rm -f "$KEEPER_PID_FILE"
    fi
    pkill -9 -f "cmd wifi start-scan" 2>/dev/null
    echo "airmon_wake" > /sys/power/wake_unlock 2>/dev/null
    iw dev "$IFACE" set power_save on 2>/dev/null
}

stop_hopper() {
    if [ -f "$HOP_PID_FILE" ]; then
        local pid
        pid=$(cat "$HOP_PID_FILE" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            kill -9 "$pid" 2>/dev/null
            echo "[*] Stopped channel hopper (PID $pid)."
        fi
        rm -f "$HOP_PID_FILE"
    fi
}

start_monitor() {
    local channel="6"
    local bw="20"
    if [ "$1" = "wlan0" ] || [ "$1" = "wlan1" ]; then
        IFACE="$1"
        channel="${2:-6}"
        bw="${3:-20}"
    else
        channel="${1:-6}"
        bw="${2:-20}"
    fi

    echo "[*] Initializing MediaTek monitor mode on $IFACE (Channel $channel, ${bw}MHz)..."

    stop_hopper

    # Engage pure Linux isolation
    suppress_android_scanning

    local res=""
    local retries=5
    while [ $retries -gt 0 ]; do
        res=$(send_driver_cmd "MONITOR 1 $channel $bw 0")
        if [ "$res" = "OK" ]; then break; fi
        sleep 0.5
        retries=$((retries - 1))
    done
    if [ "$res" != "OK" ]; then
        echo "[-] Driver command returned: '$res'." >&2
        restore_android_scanning
        return 1
    fi

    # Detect created monitor interface (mon0, wlan0mon, or radiotap0)
    if ip link show mon0 >/dev/null 2>&1; then
        MON_IFACE="mon0"
    elif ip link show wlan0mon >/dev/null 2>&1; then
        MON_IFACE="wlan0mon"
    else
        MON_IFACE="radiotap0"
    fi

    # Disable power save and hold wake lock so baseband never goes to sleep
    iw dev "$IFACE" set power_save off 2>/dev/null
    echo "airmon_wake" > /sys/power/wake_lock 2>/dev/null

    # Sync physical hardware MAC to monitor interface to prevent 00:00:00:00:00:00 injection drops
    if [ -f "/sys/class/net/$IFACE/address" ]; then
        local hw_mac
        hw_mac=$(cat "/sys/class/net/$IFACE/address" 2>/dev/null)
        if [ -n "$hw_mac" ] && [ "$hw_mac" != "00:00:00:00:00:00" ]; then
            ip link set "$MON_IFACE" address "$hw_mac" 2>/dev/null
        fi
    fi

    # Bring up monitor interface
    ip link set "$MON_IFACE" up 2>/dev/null
    sleep 0.2

    # Start keeper service so baseband never dozes / power-gates into 90s sleep
    start_keeper

    if ip link show "$MON_IFACE" >/dev/null 2>&1; then
        echo "[+] Interface $MON_IFACE created and UP."
        echo "[+] Baseband keep-alive active (zero idle periods)."
        echo "[+] Pure Linux isolation active: zero Android background interference."
        echo "[+] Ready for raw capture: tcpdump -i $MON_IFACE -n -e -vv"
    else
        echo "[-] Error: $MON_IFACE failed to appear in netdev list." >&2
        restore_android_scanning
        return 1
    fi
}

stop_monitor() {
    echo "[*] Disabling monitor mode on $IFACE..."
    stop_hopper
    stop_keeper

    send_driver_cmd "MONITOR 0" >/dev/null 2>&1
    ip link set "mon0" down >/dev/null 2>&1
    ip link set "wlan0mon" down >/dev/null 2>&1
    ip link set "radiotap0" down >/dev/null 2>&1

    # Restore Android network and background scan configurations
    restore_android_scanning

    echo "[+] Monitor mode disabled and system restored."
}

set_channel() {
    local channel="$1"
    local bw="${2:-20}"

    if [ -z "$channel" ]; then
        echo "[-] Usage: airmon-mtk channel <channel> [20|40]" >&2
        return 1
    fi

    # 1. Stop background channel hopper if active
    stop_hopper

    # 2. Ensure Android background scans are frozen
    suppress_android_scanning

    local res
    res=$(send_driver_cmd "MONITOR 1 $channel $bw 0")
    if [ "$res" = "OK" ]; then
        echo "$channel" > /data/local/tmp/airmon_channel 2>/dev/null
        echo "[+] Switched $MON_IFACE to Channel $channel (${bw}MHz)."
    else
        echo "[-] Failed to switch channel: '$res'" >&2
        return 1
    fi
}

start_hopper() {
    local delay="${1:-0.12}"
    stop_hopper

    echo "[*] Starting high-speed channel hopper (1-13 weighted, delay ${delay}s)..."
    iw dev "$IFACE" set power_save off 2>/dev/null
    echo "airmon_wake" > /sys/power/wake_lock 2>/dev/null

    nohup sh -c '
        while true; do
            # Non-overlapping channels (1, 6, 11) weighted for fastest beacon acquisition
            for ch in 1 6 11 1 2 6 7 11 12 1 3 6 8 11 13 4 9 5 10; do
                wpa_cli -i "'"$IFACE"'" -p "'"$WPA_SOCKET_DIR"'" driver "MONITOR 1 $ch 20 0" >/dev/null 2>&1
                sleep "'"$delay"'"
            done
        done
    ' >/dev/null 2>&1 &
    local hop_pid=$!
    echo "$hop_pid" > "$HOP_PID_FILE"
    echo "[+] High-speed hopper running in background with PID $hop_pid."
}

sniff_packets() {
    local mon_dev="mon0"
    if ip link show mon0 >/dev/null 2>&1; then
        mon_dev="mon0"
    elif ip link show wlan0mon >/dev/null 2>&1; then
        mon_dev="wlan0mon"
    else
        mon_dev="radiotap0"
    fi

    # Wake pulse before launching capture
    iw dev "$IFACE" set power_save off 2>/dev/null

    # Trap SIGINT / SIGTERM to ensure child processes are terminated
    trap 'pkill -P $$ 2>/dev/null; pkill -9 -f "tcpdump -i $mon_dev" 2>/dev/null; exit 0' INT TERM

    # Defaults
    local channel=""
    local pcap_file=""
    local target_bssid=""
    local target_client=""
    local frame_filter=""
    local custom_filter=""
    local packet_count=""
    local verbosity="-vv"
    local hex_dump=""
    local use_airodump=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --airodump|--scan)
                use_airodump=1
                shift
                ;;
            -i|--iface)
                mon_dev="$2"
                shift 2
                ;;
            -c|--channel)
                channel="$2"
                shift 2
                ;;
            -w|--write|-o|--output)
                pcap_file="$2"
                shift 2
                ;;
            -b|--bssid)
                target_bssid="$2"
                shift 2
                ;;
            -d|--client)
                target_client="$2"
                shift 2
                ;;
            -n|-c-count|--count)
                packet_count="$2"
                shift 2
                ;;
            -v)
                verbosity="-v"
                shift
                ;;
            -vv)
                verbosity="-vv"
                shift
                ;;
            -vvv)
                verbosity="-vvv"
                shift
                ;;
            -q|--quiet)
                verbosity=""
                shift
                ;;
            -X|-XX|--hex)
                hex_dump="-XX"
                shift
                ;;
            --deauth)
                frame_filter="wlan type mgt subtype deauth or wlan type mgt subtype disassoc"
                shift
                ;;
            --beacon)
                frame_filter="wlan type mgt subtype beacon or wlan type mgt subtype probe-req or wlan type mgt subtype probe-resp"
                shift
                ;;
            --data)
                frame_filter="wlan type data"
                shift
                ;;
            --eapol|--handshake)
                frame_filter="ether proto 0x888e"
                shift
                ;;
            -f|--filter)
                custom_filter="$2"
                shift 2
                ;;
            -h|--help)
                echo "Usage: airmon-sniff [options]"
                echo "       airmon-mtk sniff [options]"
                echo ""
                echo "Default: Captures EVERY single 802.11 packet live (headers + signal + info)."
                echo ""
                echo "Options:"
                echo "  --airodump, --scan Live interactive airodump-ng target scanner
  -c <channel|all>  Lock to channel (1-14, 36-165) or sweep all (hop)"
                echo "  -w <file.pcap>    Save raw frames to PCAP capture file"
                echo "  -b <bssid>        Filter packets by AP BSSID / MAC address"
                echo "  -d <client_mac>   Filter packets by client station MAC address"
                echo "  -n <count>        Stop capture after receiving N packets"
                echo "  -X, --hex         Show raw packet payload hex/ASCII dump"
                echo "  -v, -vv, -vvv     Control detail/verbosity level (default: -vv)"
                echo "  -q, --quiet       Brief output without verbose packet headers"
                echo "  --deauth          Capture only Deauth and Disassociation frames"
                echo "  --beacon          Capture only Beacons and Probe Requests/Responses"
                echo "  --data            Capture only 802.11 Data frames"
                echo "  --eapol           Capture only WPA/WPA2/WPA3 4-way handshake frames"
                echo "  -f <bpf_filter>   Custom tcpdump/BPF filter expression"
                echo "  -i <interface>    Monitor interface to use (default: $mon_dev)"
                return 0
                ;;
            *)
                if [ -z "$pcap_file" ] && [ "${1#-}" = "$1" ]; then
                    pcap_file="$1"
                    shift
                else
                    echo "[-] Unknown option: $1 (run with -h for help)" >&2
                    return 1
                fi
                ;;
        esac
    done

    # Handle channel selection
    if [ "$channel" = "all" ] || [ "$channel" = "hop" ]; then
        start_hopper
    elif [ -n "$channel" ]; then
        set_channel "$channel"
    fi

    # Construct BPF filter
    local bpf=""
    if [ -n "$target_bssid" ]; then
        bpf="wlan addr1 $target_bssid or wlan addr2 $target_bssid or wlan addr3 $target_bssid"
    fi
    if [ -n "$target_client" ]; then
        local client_bpf="wlan addr1 $target_client or wlan addr2 $target_client"
        if [ -n "$bpf" ]; then
            bpf="($bpf) and ($client_bpf)"
        else
            bpf="$client_bpf"
        fi
    fi
    if [ -n "$frame_filter" ]; then
        if [ -n "$bpf" ]; then
            bpf="($bpf) and ($frame_filter)"
        else
            bpf="$frame_filter"
        fi
    fi
    if [ -n "$custom_filter" ]; then
        if [ -n "$bpf" ]; then
            bpf="($bpf) and ($custom_filter)"
        else
            bpf="$custom_filter"
        fi
    fi

    echo "============================================================"
    echo "  MediaTek 802.11 Packet Sniffer (RMX3171 / gen4m)"
    echo "============================================================"
    echo "[*] Interface: $mon_dev"
    if [ -f "$HOP_PID_FILE" ] && kill -0 "$(cat "$HOP_PID_FILE" 2>/dev/null)" 2>/dev/null; then
        echo "[*] Channel:   HOPPING across all channels (1-13)"
    else
        echo "[*] Channel:   Active monitor channel"
    fi
    [ -n "$target_bssid" ] && echo "[*] AP Filter: BSSID $target_bssid"
    [ -n "$target_client" ] && echo "[*] Client:    MAC $target_client"
    [ -n "$frame_filter" ] && echo "[*] Frame Type: $frame_filter"
    [ -n "$pcap_file" ] && echo "[*] Output:    Writing PCAP to $pcap_file"
    [ -n "$bpf" ] && echo "[*] BPF Filter: '$bpf'"
    echo "[*] Starting raw 802.11 packet capture (Press Ctrl+C to stop)..."
    echo "------------------------------------------------------------"

    # Ensure radio wake state
    iw dev "$IFACE" set power_save off 2>/dev/null

    if [ "$use_airodump" -eq 1 ]; then
        local airodump_bin="/data/data/com.termux/files/usr/bin/airodump-ng"
        [ ! -x "$airodump_bin" ] && airodump_bin="$(command -v airodump-ng 2>/dev/null)"
        if [ ! -x "$airodump_bin" ]; then
            echo "[-] Error: airodump-ng binary not found in Termux or PATH." >&2
            return 1
        fi
        export LD_LIBRARY_PATH="/data/data/com.termux/files/usr/lib:$LD_LIBRARY_PATH"

        local airodump_opts=""
        local hopping_started=0
        if [ -n "$channel" ] && [ "$channel" != "all" ] && [ "$channel" != "hop" ]; then
            airodump_opts="$airodump_opts -c $channel"
        else
            airodump_opts="$airodump_opts --band abg"
            start_hopper 0.18 >/dev/null 2>&1
            hopping_started=1
        fi
        [ -n "$target_bssid" ] && airodump_opts="$airodump_opts --bssid $target_bssid"
        [ -n "$pcap_file" ] && airodump_opts="$airodump_opts -w ${pcap_file%.*}"

        trap '[ "$hopping_started" -eq 1 ] && stop_hopper >/dev/null 2>&1; exit 0' INT TERM EXIT

        echo "[*] Launching live airodump-ng target scanner on $mon_dev..."
        "$airodump_bin" $airodump_opts "$mon_dev"
        [ "$hopping_started" -eq 1 ] && stop_hopper >/dev/null 2>&1
        return 0
    fi

    # If PCAP output is requested, use direct -w
    if [ -n "$pcap_file" ]; then
        exec tcpdump -i "$mon_dev" -s 0 -w "$pcap_file" ${packet_count:+-c "$packet_count"} $bpf
    else
        exec tcpdump -i "$mon_dev" -n -e $verbosity $hex_dump ${packet_count:+-c "$packet_count"} $bpf
    fi
}

show_status() {
    echo "=== MediaTek Monitor Mode Status ==="
    local iface_found=""
    if ip link show mon0 >/dev/null 2>&1; then
        iface_found="mon0"
    elif ip link show wlan0mon >/dev/null 2>&1; then
        iface_found="wlan0mon"
    elif ip link show radiotap0 >/dev/null 2>&1; then
        iface_found="radiotap0"
    fi

    if [ -n "$iface_found" ]; then
        echo "[+] $iface_found exists:"
        ip link show "$iface_found"
    else
        echo "[-] Monitor interface is not created."
    fi

    if [ -f "$HOP_PID_FILE" ]; then
        local pid
        pid=$(cat "$HOP_PID_FILE" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "[+] Channel hopper is ACTIVE (PID: $pid)."
        else
            echo "[-] Channel hopper is INACTIVE."
        fi
    else
        echo "[-] Channel hopper is INACTIVE."
    fi
}

check_root

case "$1" in
    start)
        start_monitor "$2" "$3"
        ;;
    stop)
        stop_monitor
        ;;
    channel|set-channel)
        set_channel "$2" "$3"
        ;;
    hop)
        start_hopper "$2"
        ;;
    sniff)
        shift
        sniff_packets "$@"
        ;;
    status)
        show_status
        ;;
    *)
        echo "airmon-mtk: MediaTek Wi-Fi Monitor Mode Tool"
        echo "Usage: airmon-mtk <command> [options]"
        echo ""
        echo "Commands:"
        echo "  start [channel] [bw]   Enable monitor mode (default ch 6, 20MHz)"
        echo "  stop                   Disable monitor mode and stop hopper"
        echo "  channel <channel> [bw] Switch monitor channel on the fly"
        echo "  hop [delay_seconds]    Start background channel hopping"
        echo "  sniff [out.pcap]       Stream live packets or dump to PCAP"
        echo "  status                 Display monitor interface status"
        exit 1
        ;;
esac
