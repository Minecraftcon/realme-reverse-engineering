#!/bin/sh
# airmon-mtk: CLI monitor mode wrapper for MediaTek gen4m wireless drivers
# Target Device: Realme Narzo 30A (RMX3171 / MT6768 Helio G85)
# Reverse-engineered by Shado & Antigravity (2026)

export PATH="/data/data/com.termux/files/usr/bin:/product/bin:/apex/com.android.runtime/bin:/apex/com.android.art/bin:/system_ext/bin:/system/bin:/system/xbin:/odm/bin:/vendor/bin:/vendor/xbin:$PATH"

WPA_SOCKET_DIR="/data/vendor/wifi/wpa/sockets"
IFACE="wlan0"
MON_IFACE="mon0"
HOP_PID_FILE="/data/local/tmp/airmon_mtk_hop.pid"

check_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "[-] Error: airmon-mtk must be run as root." >&2
        exit 1
    fi
}

send_driver_cmd() {
    local cmd="$1"
    local wpa_bin
    wpa_bin=$(command -v wpa_cli 2>/dev/null || echo "/vendor/bin/wpa_cli")
    "$wpa_bin" -i "$IFACE" -p "$WPA_SOCKET_DIR" driver "$cmd" 2>/dev/null
}

stop_hopper() {
    if [ -f "$HOP_PID_FILE" ]; then
        local pid
        pid=$(cat "$HOP_PID_FILE" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            kill -9 "$pid" 2>/dev/null
            echo "[*] Stopped channel hopper (PID $pid)."
        fi
        rm -f "$HOP_PID_FILE"
    fi
}

start_monitor() {
    local channel="${1:-6}"
    local bw="${2:-20}"

    echo "[*] Initializing MediaTek monitor mode on $IFACE (Channel $channel, ${bw}MHz)..."

    stop_hopper

    # Check if wpa_supplicant socket is present; if not, auto-enable Wi-Fi
    if [ ! -S "$WPA_SOCKET_DIR/$IFACE" ]; then
        echo "[*] Wi-Fi control socket not found. Enabling Wi-Fi..."
        svc wifi enable >/dev/null 2>&1
        local tries=0
        while [ $tries -lt 10 ]; do
            if [ -S "$WPA_SOCKET_DIR/$IFACE" ]; then break; fi
            sleep 0.5
            tries=$((tries + 1))
        done
    fi

    local res=""
    local retries=5
    while [ $retries -gt 0 ]; do
        res=$(send_driver_cmd "MONITOR 1 $channel $bw 0")
        if [ "$res" = "OK" ]; then break; fi
        sleep 0.5
        retries=$((retries - 1))
    done
    if [ "$res" != "OK" ]; then
        echo "[-] Driver command returned: '$res'. Make sure Wi-Fi is enabled." >&2
        return 1
    fi

    # Detect created monitor interface (mon0, wlan0mon, or radiotap0)
    if ip link show mon0 >/dev/null 2>&1; then
        MON_IFACE="mon0"
    elif ip link show wlan0mon >/dev/null 2>&1; then
        MON_IFACE="wlan0mon"
    else
        MON_IFACE="radiotap0"
    fi

    # Bring up monitor interface
    ip link set "$MON_IFACE" up 2>/dev/null
    sleep 0.2

    if ip link show "$MON_IFACE" >/dev/null 2>&1; then
        echo "[+] Interface $MON_IFACE created and UP."
        echo "[+] Ready for raw capture: tcpdump -i $MON_IFACE -n -e -vv"
    else
        echo "[-] Error: $MON_IFACE failed to appear in netdev list." >&2
        return 1
    fi
}

stop_monitor() {
    echo "[*] Disabling monitor mode on $IFACE..."
    stop_hopper

    send_driver_cmd "MONITOR 0" >/dev/null 2>&1
    ip link set "mon0" down >/dev/null 2>&1
    ip link set "wlan0mon" down >/dev/null 2>&1
    ip link set "radiotap0" down >/dev/null 2>&1
    echo "[+] Monitor mode disabled."
}

set_channel() {
    local channel="$1"
    local bw="${2:-20}"

    if [ -z "$channel" ]; then
        echo "[-] Usage: airmon-mtk set-channel <channel> [20|40]" >&2
        return 1
    fi

    local res
    res=$(send_driver_cmd "MONITOR 1 $channel $bw 0")
    if [ "$res" = "OK" ]; then
        echo "[+] Switched $MON_IFACE to Channel $channel (${bw}MHz)."
    else
        echo "[-] Failed to switch channel: '$res'" >&2
        return 1
    fi
}

start_hopper() {
    local delay="${1:-0.12}"
    stop_hopper

    echo "[*] Starting high-speed channel hopper (1-13 weighted, delay ${delay}s)..."
    nohup sh -c '
        while true; do
            # Non-overlapping channels (1, 6, 11) weighted for fastest beacon acquisition
            for ch in 1 6 11 1 2 6 7 11 12 1 3 6 8 11 13 4 9 5 10; do
                wpa_cli -i "'"$IFACE"'" -p "'"$WPA_SOCKET_DIR"'" driver "MONITOR 1 $ch 20 0" >/dev/null 2>&1
                sleep "'"$delay"'"
            done
        done
    ' >/dev/null 2>&1 &
    local hop_pid=$!
    echo "$hop_pid" > "$HOP_PID_FILE"
    echo "[+] High-speed hopper running in background with PID $hop_pid."
}

sniff_packets() {
    local mon_dev="mon0"
    if ip link show mon0 >/dev/null 2>&1; then
        mon_dev="mon0"
    elif ip link show wlan0mon >/dev/null 2>&1; then
        mon_dev="wlan0mon"
    else
        mon_dev="radiotap0"
    fi

    local pcap="$1"
    if [ -n "$pcap" ]; then
        echo "[*] Capturing raw 802.11 frames to $pcap (Press Ctrl+C to stop)..."
        tcpdump -i "$mon_dev" -w "$pcap" -s 0
    else
        echo "[*] Streaming live 802.11 management frames (Press Ctrl+C to stop)..."
        tcpdump -i "$mon_dev" -n -e -vv
    fi
}

show_status() {
    echo "=== MediaTek Monitor Mode Status ==="
    local iface_found=""
    if ip link show mon0 >/dev/null 2>&1; then
        iface_found="mon0"
    elif ip link show wlan0mon >/dev/null 2>&1; then
        iface_found="wlan0mon"
    elif ip link show radiotap0 >/dev/null 2>&1; then
        iface_found="radiotap0"
    fi

    if [ -n "$iface_found" ]; then
        echo "[+] $iface_found exists:"
        ip link show "$iface_found"
    else
        echo "[-] Monitor interface is not created."
    fi

    if [ -f "$HOP_PID_FILE" ]; then
        local pid
        pid=$(cat "$HOP_PID_FILE" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "[+] Channel hopper is ACTIVE (PID: $pid)."
        else
            echo "[-] Channel hopper is INACTIVE."
        fi
    else
        echo "[-] Channel hopper is INACTIVE."
    fi
}

check_root

case "$1" in
    start)
        start_monitor "$2" "$3"
        ;;
    stop)
        stop_monitor
        ;;
    channel|set-channel)
        set_channel "$2" "$3"
        ;;
    hop)
        start_hopper "$2"
        ;;
    sniff)
        sniff_packets "$2"
        ;;
    status)
        show_status
        ;;
    *)
        echo "airmon-mtk: MediaTek Wi-Fi Monitor Mode Tool"
        echo "Usage: airmon-mtk <command> [options]"
        echo ""
        echo "Commands:"
        echo "  start [channel] [bw]   Enable monitor mode (default ch 6, 20MHz)"
        echo "  stop                   Disable monitor mode and stop hopper"
        echo "  channel <channel> [bw] Switch monitor channel on the fly"
        echo "  hop [delay_seconds]    Start background channel hopping"
        echo "  sniff [out.pcap]       Stream live packets or dump to PCAP"
        echo "  status                 Display monitor interface status"
        exit 1
        ;;
esac
